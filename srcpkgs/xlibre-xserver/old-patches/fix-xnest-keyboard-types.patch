--- a/hw/xnest/Keyboard.c
+++ b/hw/xnest/Keyboard.c
@@ -115,8 +115,17 @@ xnestKeyboardProc(DeviceIntPtr pDev, int onoff)
         .minKeyCode = keymap_reply->minKeyCode,
         .maxKeyCode = keymap_reply->maxKeyCode,
         .mapWidth = keymap_reply->keysymsPerKeycode,
-        .map = xcb_get_keyboard_mapping_keysyms(keymap_reply),
+        .map = NULL
     };
+
+    /* 
+     * libxcb вернул xcb_keysym_t (uint32_t), но KeySym в сервере — это unsigned long.
+     * На 64-bit системах размеры не совпадают. Выделяем память нужного размера 
+     * и копируем значения с безопасным приведением типов.
+     */
+    size_t syms_count = (keySyms.maxKeyCode - keySyms.minKeyCode + 1) * keySyms.mapWidth;
+    keySyms.map = calloc(syms_count, sizeof(KeySym));
+    memcpy(keySyms.map, xcb_get_keyboard_mapping_keysyms(keymap_reply), syms_count * sizeof(xcb_keysym_t));
